{
  "name": "devkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node scripts/serve.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "format": "prettier --write index.html manifest.webmanifest css js scripts tests docs README.md CHANGELOG.md package.json",
    "format:check": "prettier --check index.html manifest.webmanifest css js scripts tests docs README.md CHANGELOG.md package.json",
    "test:tools": "node tests/tools-browser.cjs",
    "test:security": "node tests/security-browser.cjs",
    "test:ux": "node tests/ux-browser.cjs",
    "test:a11y": "node tests/accessibility.cjs",
    "audit:performance": "node scripts/audit-performance.js",
    "build:sw": "node scripts/build-sw.js",
    "test:pwa": "node tests/pwa-browser.cjs",
    "test:edge": "node tests/edge-smoke.cjs",
    "audit:utilities": "node scripts/audit-utilities.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
